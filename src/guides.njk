---
layout: "layouts/base.njk"
title: "Guides"
description: "Free guides on staff and event transport for HR and operations teams in Cape Town."
permalink: "/guides/"
---
<section class="page-hero dark">
  <div class="container">
    <h1>Guides</h1>
    <p class="lead">Practical guides for HR and ops teams. Use them whether or not you work with us.</p>
  </div>
</section>
<section class="section">
  <div class="container">
    <div class="grid grid-3">
      {% for guide in collections.guides %}
      <a class="card card-link" href="{{ guide.url }}">
        <p class="eyebrow">{% if guide.data.gated %}Free download{% else %}Read online{% endif %}{% if guide.data.readTime %} · {{ guide.data.readTime }}{% endif %}</p>
        <h2 class="h3">{{ guide.data.title }}</h2>
        <p>{{ guide.data.summary }}</p>
      </a>
      {% endfor %}
    </div>
  </div>
</section>
