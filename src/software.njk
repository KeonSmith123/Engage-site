      </div>
      <figure class="cv-row-shot cv-phones">
        <div class="shot-phone"><img src="/assets/img/app/driver-code.webp" alt="Driver app: entering a rider's boarding code" width="640" height="1300" loading="lazy"></div>
        <div class="shot-phone"><img src="/assets/img/app/rider-home.webp" alt="Rider app home screen with the next pickup" width="640" height="1300" loading="lazy"></div>
