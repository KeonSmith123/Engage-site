{# 3. FLEET TYPES: one interactive block instead of two card grids #}
<section class="section section-cream" id="fleet-types">
  <div class="container">
    <p class="eyebrow">Built for your kind of fleet</p>
    <h2 class="section-title">What kind of fleet do you run?</h2>
    <div class="cv-tabs" role="tablist" aria-label="Fleet types" data-cv-tabs>
      <button class="cv-tab" role="tab" id="tab-ehailing" aria-controls="panel-ehailing" aria-selected="true">E-hailing</button>
      <button class="cv-tab" role="tab" id="tab-staff" aria-controls="panel-staff" aria-selected="false">Staff transport</button>
      <button class="cv-tab" role="tab" id="tab-tours" aria-controls="panel-tours" aria-selected="false">Tours &amp; experiences</button>
      <button class="cv-tab" role="tab" id="tab-company" aria-controls="panel-company" aria-selected="false">Company vehicles</button>
    </div>

    <div class="cv-panel" role="tabpanel" id="panel-ehailing" aria-labelledby="tab-ehailing">
      <div>
        <h3>Cars on Uber and Bolt, drivers on rental.</h3>
        <ul class="ticks">
          <li>Uber and Bolt earnings imported per driver</li>
          <li>Rent, ad hoc payments and shortfalls carried into next week</li>
          <li>Debt and payment plans per driver</li>
          <li>Every fine matched to whoever had the car that day</li>
        </ul>
        <p class="cv-modules">Core + E-hailing + Vehicle management</p>
      </div>
      <figure class="cv-panel-shot"><img src="/assets/img/app/convoi-vehicle-tracker.webp" alt="Vehicle tracker card: daily kilometres split into trips, Uber and personal use" width="846" height="1090" loading="lazy"></figure>
    </div>

    <div class="cv-panel" role="tabpanel" id="panel-staff" aria-labelledby="tab-staff">
      <div>
        <h3>You move people for companies.</h3>
        <ul class="ticks">
          <li>Rider app for bookings, changes and credits</li>
          <li>A draft weekly schedule with suggested drivers</li>
          <li>Boarding codes, live tracking and lateness stats</li>
          <li>Invoices matched to the trips that ran</li>
        </ul>
        <p class="cv-modules">Core + Staff transport</p>
      </div>
      <figure class="cv-panel-shot"><div class="shot-phone"><img src="/assets/img/app/rider-book-month.webp" alt="Rider app: booking the month by shift" width="640" height="1300" loading="lazy"></div></figure>
    </div>

    <div class="cv-panel" role="tabpanel" id="panel-tours" aria-labelledby="tab-tours">
      <div>
        <h3>You sell tours and experiences.</h3>
        <ul class="ticks">
          <li>A booking page under your own brand</li>
          <li>Fixed-price trips and group quotes with deposits</li>
          <li>Card payments, with each driver's share worked out per trip</li>
          <li>Partner operators run their own drivers inside your fleet</li>
        </ul>
        <p class="cv-soon"><b>Coming soon:</b> guided tour itineraries. Stop-by-stop stories and photos in English, German, French, Dutch or Portuguese, with the same guide in the driver's app.</p>
        <p class="cv-modules">Core + Bookings &amp; partners + Sub-fleets</p>
      </div>
      <figure class="cv-panel-shot"><div class="shot-phone"><img src="/assets/img/app/rider-private-trip.webp" alt="Booking a private trip with pick-up, drop-off, date, time and passengers" width="640" height="1300" loading="lazy"></div></figure>
    </div>

    <div class="cv-panel" role="tabpanel" id="panel-company" aria-labelledby="tab-company">
      <div>
        <h3>Your company runs its own vehicles.</h3>
        <ul class="ticks">
          <li>A fleet register for owned and third-party cars</li>
          <li>Pre-trip inspections with photos, straight from the driver's app</li>
          <li>Incidents, services due and the full service log per car</li>
          <li>Tracker kilometres and fines tied to the driver and the car</li>
        </ul>
        <p class="cv-modules">Core + Vehicle management</p>
      </div>
      <figure class="cv-panel-shot"><div class="shot-browser"><img src="/assets/img/app/convoi-inspections.webp" alt="Vehicle management: incidents, failed inspections and services due, with a nine-photo pre-trip inspection" width="1800" height="910" loading="lazy"></div></figure>
    </div>
  </div>
</section>

{# 4. FEATURE ROWS: three, alternating, one big screenshot each #}
