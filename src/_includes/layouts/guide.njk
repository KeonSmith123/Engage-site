---
layout: layouts/base.njk
---
<section class="page-hero dark">
  <div class="container">
    <p class="eyebrow"><a href="/guides/">Guides</a>{% if readTime %} · {{ readTime }}{% endif %}</p>
    <h1>{{ title }}</h1>
    {% if summary %}<p class="lead">{{ summary }}</p>{% endif %}
  </div>
</section>

<section class="section">
  <div class="container {% if gated %}split{% else %}prose{% endif %}">
    {% if gated %}
      <div class="prose">
        {% if preview %}{{ preview | md | safe }}{% else %}<p>Enter your details and we'll email the full guide to you.</p>{% endif %}
      </div>
      <div class="card">
        <h2 class="h3">Get the guide</h2>
        {% set formType = "guide" %}
        {% set guideSlug = page.fileSlug %}
        {% set submitLabel = "Email me the guide" %}
        {% set successText = "Done. Check your inbox for the guide. It can take a minute, and sometimes lands in spam." %}
        {% include "partials/lead-form.njk" %}
      </div>
    {% else %}
      {{ content | safe }}
      {% if file %}<p><a class="btn" href="{{ file }}" download>Download the PDF</a></p>{% endif %}
    {% endif %}
  </div>
</section>
