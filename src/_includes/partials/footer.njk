<footer class="site-footer">
  <div class="footer-stripe" aria-hidden="true"></div>
  <div class="container footer-grid">
    <div>
      <a href="/" class="footer-logo-pill"><img src="{{ site.logo }}" alt="{{ site.name }}" width="{{ site.logoWidth }}" height="{{ site.logoHeight }}" class="footer-logo"></a>
      <p class="footer-strap">FLEET | TRANSPORT | BRANDING</p>
      <p class="muted">{{ site.legalName }} · Reg {{ site.regNo }} · {{ contact.address }}</p>
    </div>
    <div>
      <h2 class="footer-head">Services</h2>
      <ul class="plain">
        <li><a href="/staff-transport/">Staff &amp; shift transport</a></li>
        <li><a href="/events/">Events &amp; groups</a></li>
        <li><a href="/rides/">CapeX Rides</a></li>
        <li><a href="/contact/?service=branding">Fleet branding</a></li>
        <li><a href="/software/">Convoi OS software</a></li>
      </ul>
    </div>
    <div>
      <h2 class="footer-head">Contact</h2>
      <ul class="plain">
        {% if contact.whatsapp %}<li><a href="https://wa.me/{{ contact.whatsapp }}" rel="noopener">WhatsApp {{ contact.whatsappDisplay }}</a></li>{% endif %}
        {% if contact.phone %}<li><a href="tel:+27{{ contact.phone | replace(' ', '') | replace('0', '', 1) }}">{{ contact.phone }}</a></li>{% endif %}
        <li><a href="mailto:{{ contact.email }}">{{ contact.email }}</a></li>
        <li><a href="/guides/">Guides</a></li>
        <li><a href="/privacy/">Privacy policy</a></li>
      </ul>
    </div>
  </div>
  <div class="container footer-base">
    <p class="muted">&copy; {% year %} {{ site.legalName }}. All rights reserved.</p>
  </div>
</footer>
